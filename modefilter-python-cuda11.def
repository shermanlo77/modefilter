BootStrap: docker
From: ubuntu:22.04

%environment
    export LC_ALL=C
    export PYTHONNOUSERSITE=1

%post
    nvcc_arch="sm_80"
    cupy_version="cuda11x"

    apt update
    apt install -y git
    apt install -y gcc
    apt install -y nvidia-cuda-toolkit
    apt install -y python-is-python3
    apt install -y python3-pip
    apt install -y python3-venv

    cd /usr/local/src
    git clone https://github.com/shermanlo77/modefilter.git
    cd modefilter
    make NVCC_ARCH=${nvcc_arch}
    python -m venv venv
    . venv/bin/activate
    pip install --upgrade build
    pip install .
    pip install .[${cupy_version}]

%runscript
    . /usr/local/src/modefilter/venv/bin/activate
    python "$@"
