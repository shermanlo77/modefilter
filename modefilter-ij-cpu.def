BootStrap: docker
From: ubuntu

%environment
    export LC_ALL=C
    export _JAVA_OPTIONS="-Duser.home=/tmp"

%post
    apt update
    apt install -y git
    apt install -y openjdk-8-jdk
    apt install -y maven
    apt install -y wget
    apt install -y unzip

    cd /tmp
    wget https://wsr.imagej.net/distros/linux/ij154-linux64-java8.zip
    unzip ij154-linux64-java8.zip -d /opt

    cd /usr/src
    git clone https://github.com/shermanlo77/modefilter.git
    cd modefilter
    mvn package

    cd target
    cp Empirical_Null_Filter*.jar /opt/ImageJ/plugins/
    cp -r libs /opt/ImageJ/jars

%runscript
    exec /opt/ImageJ/ImageJ "$@"
