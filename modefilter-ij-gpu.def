BootStrap: docker
From: ubuntu:26.04

%environment
    export LC_ALL=C
    export _JAVA_OPTIONS="-Duser.home=/tmp"

%arguments
    nvcc_arch="sm_80"

%post
    export DEBIAN_FRONTEND="noninteractive"
    export DEBCONF_NONINTERACTIVE_SEEN=true

    apt update -y
    apt install -y \
        git \
        openjdk-8-jdk \
        maven \
        wget \
        unzip \
        nvidia-cuda-toolkit \
        build-essential

    cd /tmp
    wget https://wsr.imagej.net/distros/linux/ij154-linux64-java8.zip
    unzip ij154-linux64-java8.zip -d /opt

    cd /usr/src
    git clone https://github.com/shermanlo77/modefilter.git
    cd modefilter
    make NVCC_ARCH={{ nvcc_arch }}
    mvn package

    cd target
    cp Empirical_Null_Filter*.jar /opt/ImageJ/plugins/
    cp -r libs /opt/ImageJ/jars

%runscript
    exec /opt/ImageJ/ImageJ "$@"
