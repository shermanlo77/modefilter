BootStrap: docker
From: ubuntu

%environment
    export LC_ALL=C
    export PYTHONNOUSERSITE=1

%post
    nvcc_arch="sm_80"
    cupy_version="cuda12x"

    apt update
    apt install -y git
    apt install -y gcc
    apt install -y nvidia-cuda-toolkit
    apt install -y python-is-python3
    apt install -y python3-pip
    apt install -y python3-venv
    apt install -y libxcb-xinerama0 libxcb-xinput0

    cd /usr/src
    git clone https://github.com/shermanlo77/modefilter.git
    cd modefilter
    make NVCC_ARCH=${nvcc_arch}
    python -m venv venv
    . venv/bin/activate
    pip install --upgrade build
    pip install -e .
    pip install -e .[${cupy_version}]
    pip install -e .["napari"]

%runscript
    . /usr/src/modefilter/venv/bin/activate
    napari "$@"
