BootStrap: localimage
From: modefilter-cupy.sif

%environment
    export LC_ALL=C
    export PYTHONNOUSERSITE=1

%post
    export DEBIAN_FRONTEND="noninteractive"
    export DEBCONF_NONINTERACTIVE_SEEN=true

    apt update -y
    apt install -y \
        libxcb-xinerama0 \
        libxcb-xinput0 \
        libxcb-cursor0

    cd /usr/src/modefilter
    . venv/bin/activate
    pip install -e .[napari]

%runscript
    . /usr/src/modefilter/venv/bin/activate
    napari "$@"
