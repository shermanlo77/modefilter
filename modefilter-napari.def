BootStrap: docker
From: ubuntu:26.04

%environment
    export LC_ALL=C
    export PYTHONNOUSERSITE=1

%arguments
    nvcc_arch="sm_86"
    cupy_version="cuda12x"

%post
    export DEBIAN_FRONTEND="noninteractive"
    export DEBCONF_NONINTERACTIVE_SEEN=true

    apt update -y
    apt install -y \
        git \
        build-essential \
        nvidia-cuda-toolkit \
        python-is-python3 \
        python3-pip \
        python3-venv \
        libxcb-xinerama0 \
        libxcb-xinput0

    cd /usr/src
    git clone https://github.com/shermanlo77/modefilter.git
    cd modefilter
    make NVCC_ARCH={{ nvcc_arch }}
    python -m venv venv
    . venv/bin/activate
    pip install --upgrade build
    pip install -e .
    pip install -e .[{{ cupy_version }}]
    pip install -e .["napari"]

%test
    cd /usr/src/modefilter
    . venv/bin/activate
    # ensure cupy doesn't write in a read-only system
    export CUPY_CACHE_DIR=/tmp/.cupy
    pytest

%runscript
    . /usr/src/modefilter/venv/bin/activate
    napari "$@"
